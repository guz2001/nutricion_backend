# Copia este archivo a .env y completa los valores reales.
# El .env NUNCA se sube al repositorio: contiene credenciales.

# Clave criptográfica de Django. Genera una propia con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# En producción debe ser distinta a la de desarrollo y no llevar el prefijo 'django-insecure-'.
SECRET_KEY=

# True solo en desarrollo. En producción SIEMPRE False.
DEBUG=True

# Base de datos PostgreSQL
DB_NAME=nutricion_db
DB_USER=nutricion_app
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Usados solo por production.py (listas separadas por comas).
# En ALLOWED_HOSTS van los dominios reales del servidor, nunca '*'.
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
